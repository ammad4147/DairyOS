[Unit]
Description=DairyOS First Boot Provisioning
After=local-fs.target network-online.target
Wants=network-online.target
Before=dairyos.service
ConditionPathExists=/opt/dairyos-os/installer/firstboot.sh
ConditionPathExists=!/var/lib/dairyos/.firstboot-complete

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/dairyos-os/installer/firstboot.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
