  "items": [
    {"id":"disease.mastitis","name":"Mastitis","class":"udder/infectious","recognition":["abnormal milk","udder heat, swelling, pain","milk-yield change","fever or depression in severe cases"],"diagnostic_path":["history and udder examination","quarter-level milk assessment","veterinarian-directed sample and laboratory testing","interpret culture/test results with clinical context"],"management":"Prompt veterinary assessment, appropriate isolation/milking hygiene, supportive care, and veterinarian-authorised treatment; milk handling and withdrawal must follow product and veterinary authority.","urgent":["systemic illness","severe pain","recumbency","rapid deterioration"],"prevention":["milking hygiene","equipment and bedding review","case and culture surveillance"],"dairyos":["health observation","treatment","withdrawal","milk disposition","milk-yield monitoring"],"sources":["Merck Veterinary Manual cattle disease reference"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.metritis-endometritis","name":"Metritis and endometritis","class":"postpartum/reproductive","recognition":["abnormal uterine discharge","fever or depression","reduced appetite","milk-yield or fertility change"],"diagnostic_path":["calving and treatment history","clinical examination","temperature and hydration assessment","veterinary reproductive examination and testing as indicated"],"management":"Veterinary assessment is required; treatment, supportive care, and reproductive recheck depend on severity and diagnosis.","urgent":["toxaemia","dehydration","collapse","high fever"],"prevention":["transition-cow management","calving hygiene","post-calving observation"],"dairyos":["health observation","calving","treatment","follow-up","breeding state"],"sources":["Merck Veterinary Manual cattle reproduction and health references"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.milk-fever","name":"Hypocalcemia (milk fever)","class":"metabolic/postpartum","recognition":["weakness","cold extremities","staggering","recumbency","reduced rumen activity"],"diagnostic_path":["postpartum history","clinical examination","veterinarian confirmation and differential assessment"],"management":"Treat as a potential emergency; obtain veterinary direction immediately. Do not rely on chatbot guidance for calcium product, route, or dose.","urgent":["recumbency","inability to rise","bloat risk","altered consciousness"],"prevention":["transition nutrition programme","body-condition management","veterinary herd review"],"dairyos":["health observation","treatment","follow-up","milk production context"],"sources":["Merck Veterinary Manual"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.ketosis","name":"Ketosis","class":"metabolic/transition","recognition":["reduced appetite","milk-yield decline","weight or body-condition loss","abnormal behaviour or sweet odour may occur"],"diagnostic_path":["fresh-cow and feed history","clinical examination","veterinarian-directed ketone testing","evaluate concurrent disease"],"management":"Requires veterinary and nutrition review; address underlying transition and intake problems rather than treating a test result in isolation.","urgent":["severe depression","neurologic signs","dehydration","concurrent illness"],"prevention":["transition ration management","intake monitoring","fresh-cow surveillance"],"dairyos":["health observation","feed/TMR context","milk trend","treatment","follow-up"],"sources":["Merck Veterinary Manual"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.brd","name":"Bovine respiratory disease","class":"respiratory/infectious","recognition":["cough","nasal or ocular discharge","increased respiratory effort","fever","depression"],"diagnostic_path":["environment and cohort history","clinical respiratory examination","temperature and severity assessment","veterinary sampling/testing where indicated"],"management":"Separate and assess promptly; treatment and antimicrobial decisions require veterinary authority and must consider herd-level control.","urgent":["laboured breathing","cyanosis","collapse","rapid spread"],"prevention":["ventilation","stocking and transport management","biosecurity","approved vaccination programme"],"dairyos":["health observation","treatment","withdrawal","vaccination","alerts"],"sources":["Merck Veterinary Manual disease screening and respiratory references"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.calves-scours","name":"Calf diarrhoea/scours","class":"neonatal/enteric","recognition":["loose faeces","dehydration","weakness","poor suckling","depressed behaviour"],"diagnostic_path":["age and cohort history","hydration and temperature assessment","stool/sample testing under veterinary plan","review colostrum, hygiene, and feeding"],"management":"Prompt fluid and veterinary assessment; isolate appropriately and protect welfare. Product, fluid, and antimicrobial decisions are veterinarian-led.","urgent":["unable to stand or suckle","severe dehydration","blood or collapse","multiple affected calves"],"prevention":["colostrum programme","clean calving and feeding equipment","cohort hygiene","approved dam vaccination plan"],"dairyos":["health observation","treatment","vaccination","follow-up","youngstock history"],"sources":["FAO primary animal health guidance","Merck Veterinary Manual"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.lameness","name":"Lameness and foot disease","class":"locomotor","recognition":["altered gait","weight shifting","reduced lying/feeding","swelling or lesion"],"diagnostic_path":["locomotion and foot examination","housing and flooring history","veterinary differential diagnosis","record lesion and response"],"management":"Provide safe handling and prompt professional assessment; treatment depends on lesion and must not be guessed from a photograph or text alone.","urgent":["non-weight-bearing limb","severe pain","open wound","inability to access feed/water"],"prevention":["footbath/flooring programme","trim and housing review","early detection"],"dairyos":["health observation","treatment","follow-up","feed and milk trend"],"sources":["Merck Veterinary Manual"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.bvd","name":"Bovine viral diarrhoea (BVD)","class":"viral/reproductive","recognition":["variable diarrhoea or respiratory signs","poor growth","reproductive loss","persistent infection risk"],"diagnostic_path":["herd and reproductive history","veterinary examination","appropriate antigen/antibody or other testing","interpret tests with vaccination and exposure context"],"management":"Herd-level veterinary surveillance and biosecurity are essential; treatment is primarily supportive and control depends on the diagnosed situation.","urgent":["severe illness","abortion cluster","suspected persistent infection","rapid herd spread"],"prevention":["biosecurity","testing strategy","veterinarian-approved vaccination programme","breeding-risk management"],"dairyos":["health observation","vaccination","breeding","abortion","herd alerts"],"sources":["Merck Veterinary Manual BVD reference"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.ibr","name":"Infectious bovine rhinotracheitis (IBR)","class":"viral/respiratory-reproductive","recognition":["respiratory signs","fever","nasal discharge","conjunctivitis","reproductive effects"],"diagnostic_path":["clinical and cohort history","veterinary examination","sample/testing programme","distinguish from other respiratory disease"],"management":"Use veterinary-directed isolation, testing, supportive care, and vaccination/control planning.","urgent":["respiratory distress","high mortality","abortion cluster","rapid spread"],"prevention":["biosecurity","veterinarian-approved vaccination","cohort management"],"dairyos":["health observation","vaccination","breeding","milk trend","alerts"],"sources":["Merck Veterinary Manual"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.leptospirosis","name":"Leptospirosis","class":"bacterial/zoonotic/reproductive","recognition":["fever or illness","reproductive loss","milk change","possible jaundice or haemoglobinuria"],"diagnostic_path":["herd and reproductive history","veterinary examination","paired or appropriate laboratory testing","consider zoonotic and environmental risk"],"management":"Veterinary-led diagnosis, biosecurity, treatment, and vaccination planning; protect handlers from exposure.","urgent":["severe illness","abortion storm","human exposure concern","acute milk drop"],"prevention":["biosecurity","water/rodent control","approved vaccination programme","protective handling"],"dairyos":["health observation","vaccination","breeding","treatment","withdrawal"],"sources":["Merck Veterinary Manual leptospirosis reference","WOAH vaccination guidance"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.brucellosis","name":"Brucellosis","class":"bacterial/zoonotic/reproductive","recognition":["abortion or reproductive loss","retained reproductive problems","herd reproductive pattern"],"diagnostic_path":["veterinary and authority-directed investigation","appropriate official sampling/testing","traceability and cohort review"],"management":"Follow government veterinary authority and veterinarian instructions; do not move, sell, vaccinate, or treat suspected cases based on chatbot advice.","urgent":["abortion cluster","suspected zoonotic exposure","regulatory notification trigger"],"prevention":["biosecurity","official surveillance","approved control programme"],"dairyos":["health observation","breeding","abortion","vaccination","audit"],"sources":["WOAH disease-control framework","FAO animal-health guidance"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.fmd","name":"Foot-and-mouth disease (FMD)","class":"highly contagious/regulated","recognition":["blisters or erosions","drooling","lameness","fever","rapid herd spread"],"diagnostic_path":["immediate veterinary/official notification","biosecurity and movement control","official sampling/testing"],"management":"Treat as a regulatory emergency; isolate and notify the responsible veterinary authority immediately. Do not transport animals or attempt an improvised treatment plan.","urgent":["any credible suspicion","rapid spread","multiple animals with lesions"],"prevention":["official vaccination programme","movement biosecurity","visitor and equipment controls"],"dairyos":["health observation","vaccination","alerts","movement/audit records"],"sources":["WOAH Terrestrial Animal Health Code"],"review":"DOMAIN_REVIEW_REQUIRED"},
    {"id":"disease.heat-stress","name":"Heat stress","class":"environmental/welfare","recognition":["panting","crowding near water","reduced intake","milk decline","lethargy"],"diagnostic_path":["temperature-humidity and shade assessment","animal observation","water and ventilation review","veterinary assessment for severe cases"],"management":"Immediately improve shade, ventilation, and water access under the farm plan; escalate severe cases and monitor production/welfare.","urgent":["collapse","severe respiratory effort","inability to reach water","multiple distressed animals"],"prevention":["water capacity","shade and airflow","feeding-time adjustment","heat-stress monitoring"],"dairyos":["environmental observations","milk trends","feed context","alerts","health follow-up"],"sources":["DairyOS heat-stress intelligence implementation","veterinary welfare guidance"],"review":"IMPLEMENTATION_REVIEW_REQUIRED"},
